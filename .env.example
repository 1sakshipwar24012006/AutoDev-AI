# Copy this file to ".env" and fill in your values.  NEVER commit ".env".
# The agent only reads ".env" from the directory you launch it in (or --env-file).

# Required for real (non-mock) runs. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides ---------------------------------------------------------
# Claude model used for planning, code generation and review.
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_MAX_TOKENS=8000
# AGENT_MAX_ATTEMPTS=3
# Test command (argv-style, no shell). First token must be python/python3/py/pytest.
# AGENT_TEST_COMMAND=python -m pytest -q
# AGENT_TEST_TIMEOUT=300
# Approximate character budget for repository context sent to the model.
# AGENT_MAX_CONTEXT_CHARS=60000
# Default "owner/name" passed to the GitHub CLI (otherwise inferred from the repo).
# AGENT_GITHUB_REPO=
# Where run reports and patches are written (relative to the launch directory).
# AGENT_OUTPUT_DIR=agent_runs
